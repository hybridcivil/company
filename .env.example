# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==================================================
# HYBRID CIVIL - VERCEL & GITHUB STORAGE CONFIGURATION
# ==================================================
# Note: Keep GITHUB_TOKEN strictly private in Vercel server environment variables.
# Never expose GitHub token or repository credentials to browser-side JavaScript.

# GitHub Private Repository Storage Layer (Optional - defaults to local resilient storage if empty)
GITHUB_OWNER="hybrid-civil-org"
GITHUB_REPO="hybrid-civil-data-vault"
GITHUB_TOKEN="ghp_your_secure_fine_grained_or_classic_token_here"
GITHUB_BRANCH="main"

# Storage Driver: "github" (uses GitHub REST API storage layer) or "local" (uses synchronized indexed storage)
STORAGE_DRIVER="local"

# Security & Session Token Secret
SESSION_SECRET="hybrid-civil-secure-session-key-change-in-production"

# Company Branding Defaults
COMPANY_NAME="Hybrid Civil Engineering & Consultancy"
MANAGING_DIRECTOR="Engr. Ashraf B.Eng, M.Sc.Sc (Structural Engineering)"
